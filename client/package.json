{
  "name": "glpi-realtime-client",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=iife --target=es2020 --minify --sourcemap --outfile=../plugin/public/realtime.js",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "i18n-template": "node --experimental-strip-types --no-warnings scripts/i18n-template.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
