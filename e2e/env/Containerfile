# Disposable GLPI for the end-to-end tests: the official GLPI image, plus glpi-realtime
# (on a unix socket, as in production), HTTPS (self-signed) and the /ws location of
# deploy/examples/apache-glpi.conf. /opt/release is laid out like a release archive: up.sh
# installs the plugin from it with deploy/install.sh, as users do. /opt/realtime-old holds
# an older plugin for the upgrade test (UPGRADE_FROM). Built from the repository's root:
#   docker build -f e2e/env/Containerfile --build-arg GLPI_VERSION=12.0 .
# SERVER_SOURCE=server-prebuilt takes e2e/env/bin/glpi-realtime (a static binary, CI)
# instead of compiling it.
ARG GLPI_VERSION=12.0
ARG SERVER_SOURCE=server-build

FROM docker.io/library/rust:1-trixie AS server-build
WORKDIR /src
COPY server/ .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked && cp target/release/glpi-realtime /glpi-realtime

FROM scratch AS server-prebuilt
COPY e2e/env/bin/glpi-realtime /glpi-realtime

FROM ${SERVER_SOURCE} AS server

FROM docker.io/glpi/glpi:${GLPI_VERSION}
USER root
RUN a2enmod ssl proxy proxy_http headers \
 && mkdir -p /etc/ssl/glpi /run/glpi-realtime /etc/glpi-realtime \
 && openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj /CN=localhost \
      -addext subjectAltName=DNS:localhost,IP:127.0.0.1 \
      -keyout /etc/ssl/glpi/privkey.pem -out /etc/ssl/glpi/fullchain.pem 2>/dev/null \
 && cp /etc/ssl/glpi/fullchain.pem /usr/local/share/ca-certificates/glpi-e2e.crt \
 && update-ca-certificates >/dev/null \
 && chown www-data /etc/ssl/glpi/privkey.pem /run/glpi-realtime
COPY e2e/env/apache.conf /etc/apache2/sites-enabled/000-default.conf
COPY e2e/env/ports.conf /etc/apache2/ports.conf
COPY e2e/env/supervisor-realtime.conf /etc/supervisor/conf.d/realtime.conf
COPY e2e/env/config.toml /etc/glpi-realtime/config.toml
COPY --from=server /glpi-realtime /usr/local/bin/glpi-realtime
COPY --from=server /glpi-realtime /opt/release/bin/glpi-realtime
COPY plugin/ /opt/release/plugin/
COPY deploy/ /opt/release/deploy/
COPY e2e/env/.old/ /opt/realtime-old/
COPY --chown=www-data e2e/env/rtseed/ /var/www/glpi/plugins/rtseed/
USER www-data
