# glpi-realtime configuration: copy to /etc/glpi-realtime/config.toml (root:glpi-realtime,
# mode 640) and adapt. Check it with: glpi-realtime --config /etc/glpi-realtime/config.toml --check
# Every value can be overridden by environment: GLPI_RT_<SECTION>__<KEY>,
# e.g. GLPI_RT_LIMITS__MAX_CONNECTIONS=30000.

[listen]
type = "unix"                       # or: type = "tcp", addr = "127.0.0.1:8090"
path = "/run/glpi-realtime/rt.sock"
mode = 0o660
# Group of the web server, which must reach the socket; the service must be a member.
# Arch: http, Debian/Ubuntu: www-data, RHEL/Fedora: nginx or apache.
group = "http"

[valkey]
url = "unix:///run/valkey/valkey.sock"   # unixsocket of valkey.conf (or redis://127.0.0.1:6379)
db = 6                              # must match the plugin setting valkey_db
pool_size = 8
key_prefix = "rt:"                  # must match the plugin setting key_prefix
# Valkey ACL user (see valkey.conf.example); or GLPI_RT_VALKEY__PASSWORD in the unit's environment.
# username = "glpi-rt"
# password = "..." 

[security]
cookie_name = "glpi_rt"             # must match the plugin setting cookie_name
# Exact browser origins allowed to open the WebSocket (CSWSH protection).
allowed_origins = ["https://glpi.example.org"]
# Item types: those enabled in GLPI (the plugin's settings, "Item types"): every room needs
# a grant GLPI wrote for that very item. A list here only restricts them, e.g.
# allowed_itemtypes = ["Ticket", "Change", "Problem"]

[limits]
max_connections = 25000             # per instance
max_connections_per_user = 10       # tabs
max_watched_rooms = 200             # items whose presence a list page follows
listen_backlog = 4096               # pending connections (bursts); capped by net.core.somaxconn
max_message_bytes = 65536
max_rooms_per_connection = 50
messages_per_second = 20            # per connection
burst = 40
user_messages_per_second = 50       # all connections of a user
user_burst = 100
max_violations = 20                 # rate-limit hits before closing
outbound_queue = 256                # slower clients are dropped (close 1013); at least 128
ping_interval_secs = 30
idle_timeout_secs = 90

[revocation]
sweep_interval_secs = 15
# Instant logout: needs `notify-keyspace-events Kgx` in valkey.conf.
keyspace_events = true

[presence]
# Who is on each item: entries refreshed this often by each server instance, and dropped
# when not refreshed for ttl_secs (an instance that crashed).
heartbeat_secs = 15
ttl_secs = 45

[events]
# After `regrant` (actor removed, entity moved), time given to a browser to get a new
# grant from GLPI before it is removed from the item.
regrant_timeout_secs = 30

[locks]
# Single editor for ticket fields: a lock its holder stops renewing expires after this.
ttl_secs = 30
sweep_secs = 5                      # how often expired locks are noticed

[drafts]
# A shared draft left by a closed tab can be taken over for this long.
ttl_secs = 900

[shutdown]
grace_secs = 5

[log]
format = "text"                     # or "json"
filter = "info"                     # RUST_LOG overrides
