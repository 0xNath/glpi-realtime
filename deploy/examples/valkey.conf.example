# Valkey (or Redis) settings glpi-realtime relies on. Add them to your valkey.conf
# (Arch: /etc/valkey/valkey.conf, Debian: /etc/valkey/valkey.conf or /etc/redis/redis.conf).

# A local unix socket, readable by its group only: add the glpi-realtime user and the user
# running PHP (GLPI) to that group (Arch/Debian: valkey or redis).
unixsocket /run/valkey/valkey.sock
unixsocketperm 660

# Instant revocation of WebSocket sessions at logout (glpi-realtime: revocation.keyspace_events).
notify-keyspace-events Kgx

# Whoever can write to Valkey can forge sessions, grants and events: keep it local
# (port 0 if nothing else needs TCP) and give glpi-realtime and GLPI their own ACL user,
# limited to the project's keys and channels (keyspace notifications included):
#   user default off
#   user glpi-rt on >CHANGE-ME ~rt:* &rt:* &__keyspace@*__:rt:* +@all -@dangerous
# Then: config.toml [valkey] username/password, and in GLPI (stored encrypted):
#   bin/console glpi:config:set --context=plugin:realtime valkey_username glpi-rt
#   bin/console glpi:config:set --context=plugin:realtime valkey_password 'CHANGE-ME'
port 0
